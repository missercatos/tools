# 值空间展开: 每行输出一个候选值
expand() {
    case "$1" in
        @*) cat "${1#@}" ;;
        --gen:*) gen_runner "${1#--gen:}" ;;
        --builtin:*) BUILTIN "${1#--builtin:}" ;;
        \{*\}) eval "echo $1" | tr ' ' '\n' ;;
        *) echo "$1" | tr '&' '\n' ;;
    esac
}

# 生成器分发: $1=name[:count]
gen_runner() {
    local name="${1%%:*}" count="${1##*:}"
    [ "$name" = "$1" ] && count="$GEN_COUNT"
    case "$name" in
        md5-0e) gen_md5_0e "$count" ;;
        *) echo "未知生成器: $name（当前支持 md5-0e）" >&2; return 1 ;;
    esac
}

