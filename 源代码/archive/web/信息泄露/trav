join_url() { # $1=base $2=值
    # --user 时值仅作密码，URL 保持原样
    if [ -n "$USER" ] && [[ "$1" != *"{}"* ]]; then
        echo "$1"; return
    fi
    case "$1" in
        *\{\}*) echo "${1//\{\}/$2}" ;;
        */) echo "${1}${2}" ;;
        *) echo "${1}/${2}" ;;
    esac
}

# wildcard 预检: 用随机串探测, 若命中说明目标对任意值都返回该结果
wildcard_check() {
    local rnd url resp code
    rnd=$(date +%s%N | md5sum | head -c 10)
    url=$(join_url "$BASE" "$rnd")
    if [ -n "$USER" ]; then
        resp=$(curl "${CURL_ARGS[@]}" -u "$USER:x$rnd" -w $'\n%{http_code}' "$url" 2>/dev/null)
    else
        resp=$(curl "${CURL_ARGS[@]}" -w $'\n%{http_code}' "$url" 2>/dev/null)
    fi
    [ -z "$resp" ] && return 0
    code="${resp##*$'\n'}"
    WILDCARD_BODY="${resp%$'\n'*}"
    local hit=0
    case "$RULE" in
        ==*)            [ "$code" = "${RULE#==}" ] && hit=1 ;;
        !=*)            [ "$code" != "${RULE#!=}" ] && hit=1 ;;
        contains:*)     [[ "$WILDCARD_BODY" == *"${RULE#contains:}"* ]] && hit=1 ;;
        grep:*)         grep -qE "${RULE#grep:}" <<<"$WILDCARD_BODY" && hit=1 ;;
    esac
    if [ "$hit" = 1 ]; then
        echo "警告: 随机值也命中判定($rnd -> $code)，疑似通配响应，将过滤相同响应的候选值" >&2
    else
        WILDCARD_BODY=""
    fi
}

# 单值探测: $1=完整URL $2=候选值 $3=当前深度
probe() {
    local url="$1" val="$2" depth="$3" resp code body loc rc
    local curl_cmd
    if [ -n "$USER" ]; then
        curl_cmd=(curl "${CURL_ARGS[@]}" -u "$USER:$val" -w $'\n%{http_code}')
    else
        curl_cmd=(curl "${CURL_ARGS[@]}" -w $'\n%{http_code}')
    fi
    resp=$("${curl_cmd[@]}" "$url" 2>/dev/null)
    rc=$?
    TESTED=$((TESTED + 1))
    if [ "$rc" -ne 0 ]; then
        ERRORS=$((ERRORS + 1))
        return 1
    fi
    code="${resp##*$'\n'}"
    body="${resp%$'\n'*}"

    if [ -n "$WILDCARD_BODY" ] && [ "$body" = "$WILDCARD_BODY" ]; then
        return 1
    fi

    case "$RULE" in
        ==*)            [ "$code" = "${RULE#==}" ] || return 1 ;;
        !=*)            [ "$code" != "${RULE#!=}" ] || return 1 ;;
        contains:*)     [[ "$body" == *"${RULE#contains:}"* ]] || return 1 ;;
        grep:*)         grep -qE "${RULE#grep:}" <<<"$body" || return 1 ;;
        *)              echo "未知判别规则: $RULE" >&2; exit 1 ;;
    esac

    HIT_COUNT=$((HIT_COUNT + 1))
    FOUND=1
    echo -n "HIT: "; [ -n "$USER" ] && echo -n "$USER:$val => " || echo -n "$val => "
    echo "$url -> $code"
    if [ "$NOFOLLOW" = 1 ]; then
        loc=$(curl -s -o /dev/null -w '%{redirect_url}' "${CURL_ARGS[@]}" "$url")
        [ -n "$loc" ] && echo "    Location: $loc"
    fi
    case "$RULE" in
        grep:*) echo "$body" | grep -oE "${RULE#grep:}" | sed 's/^/    /' ;;
        contains:*) echo "    ...${RULE#contains:}..." ;;
    esac

    if [ "$RECURSE" = 1 ] && [ "$depth" -lt "$MAXDEPTH" ]; then
        run "$url" "$((depth + 1))"
    fi
}

# 主循环: $1=base $2=当前深度
run() {
    local base="$1" depth="$2" c e
    local cand exts
    mapfile -t cand < <(expand "$SPACES")
    if [ -n "$EXT_SPACE" ]; then
        mapfile -t exts < <(expand "$EXT_SPACE")
    else
        exts=("")
    fi
    for c in "${cand[@]}"; do
        for e in "${exts[@]}"; do
            probe "$(join_url "$base" "$c$e")" "$c" "$depth"
            [ "$FOUND" = 1 ] && [ "$RECURSE" = 0 ] && return 0
        done
        if [ "$DELAY" -gt 0 ]; then
            python3 -c "import time;time.sleep($DELAY/1000.0)"
        fi
    done
}

# 并行模式前也做 wildcard 检查
wildcard_check

if [ "$THREADS" -gt 1 ]; then
    [ -n "$EXT_SPACE" ] && { echo "警告: --threads 并行模式不支持 --ext，已忽略" >&2; }
    pids=()
    while IFS= read -r c; do
        probe "$(join_url "$BASE" "$c")" "$c" 1 &
        pids+=("$!")
        if [ "${#pids[@]}" -ge "$THREADS" ]; then
            wait -n 2>/dev/null
            alive=()
            for p in "${pids[@]}"; do
                kill -0 "$p" 2>/dev/null && alive+=("$p")
            done
            pids=("${alive[@]}")
        fi
    done < <(expand "$SPACES")
    wait
else
    run "$BASE" 1
fi

echo "[*] 统计: 探测 $TESTED | 命中 $HIT_COUNT | 错误 $ERRORS" >&2
exit $(( FOUND ? 0 : 1 ))