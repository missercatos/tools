#!/usr/bin/env python3
"""pwn-gdb: GDB exploit脚本生成器
用法:
    pwn-gdb <binary> [libc.so]          # 生成exploit辅助脚本
    pwn-gdb --fmt <binary>              # 生成格式串调试脚本
    pwn-gdb --heap <binary>             # 生成堆调试脚本
    pwn-gdb --attach <pid>              # 生成attach脚本
"""
import sys, os

GDB_COMMON = """#!/usr/bin/env gdb
# Auto-generated by pwn-gdb
# Usage: gdb -x {filename}

set disassembly-flavor intel
set pagination off
set follow-fork-mode child
set detach-on-fork off

# ===== 断点 =====
# break main
# break *main+XX
# break {func}

# ===== 通用显示 =====
define hook-stop
    printf "\\n===== Registers =====\\n"
    info registers
    printf "\\n===== Stack (8 words) =====\\n"
    x/8gx $rsp
    printf "\\n===== Code (at rip) =====\\n"
    x/3i $rip
end

# ===== 辅助命令 =====
define got
    info proc mappings
    # 修改为你的GOT地址
    # x/2gx 0x{addr}
end

define stack
    x/20gx $rsp
end

define heap
    # 需要pwndbg/gef
    heap
end

define libc
    info proc mappings
    # 修改为实际libc加载地址
    # set $libc = 0x{addr}
end
"""

def gen_basic(binary, libc=None):
    """生成基本exploit脚本"""
    content = GDB_COMMON.format(
        filename=os.path.basename(binary) + '.gdb',
        func='main',
        addr='601000'
    )
    
    if libc:
        content += f"""
# ===== libc 信息 =====
# libc: {libc}
# set $system = $libc + 0x{0x4f550:x}
# set $binsh  = $libc + 0x{0x1b3e1a:x}
# set $malloc = $libc + 0x{0x8fbd0:x}
"""
    
    content += f"""
# ===== 覆写GOT示例 =====
# set *0x601020 = 0x7ffff7a5c000
# 用格式串: printf "%8$lx" 查看第8个参数

# ===== 运行 =====
# starti       # 从入口点开始
# context      # pwndbg上下文
# vis_heap_chunks  # 堆可视化(pwndbg)

# b *main
# run
"""
    return content

def gen_fmt(binary):
    """生成格式串调试脚本"""
    return f"""#!/usr/bin/env gdb
# 格式串调试脚本 - {binary}

set disassembly-flavor intel
set pagination off

# ===== 格式串参数偏移检测 =====
# 先运行到printf/puts处, 输入 AAAA%p.%p.%p... 查看偏移
define fmt_scan
    # 在printf调用处断点
    # b *printf
    # r
    # 然后输入: AAAA%6$p.%7$p.%8$p.%9$p
    # 观察哪个位置出现 0x41414141
    echo 输入格式串: AAAA%6$p.%7$p.%8$p.%9$p\\n
end

# ===== 格式串读内存 =====
define fmt_leak
    # set $target = 0xADDR
    # printf "%6$s\\n", $target
    echo 用法: fmt_leak 0xADDR\\n
end

# ===== 格式串写内存 =====
define fmt_write
    # 用%hhn逐字节写
    # printf "%XXc%8$hhn%YYc%9$hhn...", *addr1, *addr2, ...
    echo 用法: 用 pwn-fmt 生成payload, 粘贴到输入\\n
end

# ===== 信息泄露 =====
define leak
    # 泄露canary: 看栈上某个固定偏移
    x/gx $rsp+OFFSET
    # 泄露libc: 泄露__libc_start_main返回地址
    # x/gx $rsp+OFFSET
end
"""

def gen_heap(binary):
    """生成堆调试脚本"""
    return f"""#!/usr/bin/env gdb
# 堆调试脚本 - {binary}
# 推荐配合 pwndbg 或 gef

set disassembly-flavor intel
set pagination off

# ===== 堆信息 =====
define heap_info
    info proc mappings
    # pwndbg: heap
    # gef: heap bins
end

# ===== 堆块查看 =====
define chunk
    # x/32gx $rdi-0x10
    # 查看 chunk header: [size] [prev_size]
    echo 用法: chunk <address>\\n
    x/16gx $arg0-0x10
end

# ===== fastbin 查看 =====
define fastbins
    # pwndbg: fastbins
    # gef: heap fastbins
    echo pwndbg: fastbins\\n
    echo gef: heap fastbins\\n
end

# ===== tcache 查看 =====
define tcache
    echo pwndbg: tcache\\n
    echo gef: heap tcache\\n
end

# ===== unsorted bin 查看 =====
define unsorted
    echo pwndbg: bins\\n
    echo gef: heap unsorted\\n
end

# ===== 常用堆断点 =====
# b __libc_malloc
# b __libc_free
# b __memcpy_avx_unaligned_erms
# b _int_malloc
"""
    
def gen_attach(pid):
    """生成attach脚本"""
    return f"""#!/usr/bin/env gdb
# Attach到进程 {pid}

set disassembly-flavor intel
set pagination off
set follow-fork-mode child

attach {pid}

# 设置断点
# break main
# break read
# break write

# 继续执行
continue
"""

def main():
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)
    
    cmd = sys.argv[1]
    
    if cmd == '--fmt':
        binary = sys.argv[2] if len(sys.argv) > 2 else 'vuln'
        content = gen_fmt(binary)
        outfile = f'pwn_fmt_{binary}.gdb'
    elif cmd == '--heap':
        binary = sys.argv[2] if len(sys.argv) > 2 else 'vuln'
        content = gen_heap(binary)
        outfile = f'pwn_heap_{binary}.gdb'
    elif cmd == '--attach':
        pid = sys.argv[2] if len(sys.argv) > 2 else '12345'
        content = gen_attach(pid)
        outfile = f'pwn_attach_{pid}.gdb'
    else:
        binary = cmd
        libc = sys.argv[2] if len(sys.argv) > 2 else None
        content = gen_basic(binary, libc)
        outfile = f'pwn_{os.path.basename(binary)}.gdb'
    
    print(f"[*] GDB script generated: {outfile}")
    print(f"[*] Usage: gdb -x {outfile}")
    print(f"    or source {outfile} in gdb")
    print(f"\n{'='*50}")
    print(content)
    
    # 写入文件
    with open(outfile, 'w') as f:
        f.write(content)
    print(f"[*] Written to {outfile}")

if __name__ == '__main__':
    main()
